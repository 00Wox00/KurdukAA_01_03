<Window x:Class="KurdukAA_01_03.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оператор мобильной связи" Height="420" Width="400">
    <StackPanel Margin="10">
        <TextBlock Text="Название оператора:"/>
        <TextBox x:Name="tbName" Margin="0,0,0,5"/>

        <TextBlock Text="Стоимость 1 минуты разговора:"/>
        <TextBox x:Name="tbCost" Margin="0,0,0,5"/>

        <TextBlock Text="Площадь покрытия:"/>
        <TextBox x:Name="tbArea" Margin="0,0,0,5"/>

        <CheckBox x:Name="cbFee" Content="Есть плата за каждое соединение" Margin="0,5,0,10"/>

        <Button x:Name="btnBase" Content="Создать (базовый класс)" Click="btnBase_Click" Margin="0,0,0,5"/>
        <Button x:Name="btnChild" Content="Создать (потомок)" Click="btnChild_Click" Margin="0,0,0,10"/>

        <TextBlock x:Name="tbResult" TextWrapping="Wrap"/>
    </StackPanel>
</Window> 